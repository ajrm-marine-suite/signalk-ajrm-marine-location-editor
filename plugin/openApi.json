{
  "openapi": "3.0.3",
  "info": {
    "title": "AJRM Marine Location Editor API",
    "version": "0.7.1",
    "description": "Versioned spatial marine locations, assisted anchoring, import/export and nearest-location lookup. The additive shared service supports optimistic removal of one Location classification without changing the public HTTP routes."
  },
  "x-ajrm-shared-service": {
    "contract": "ajrm-marine-locations-service-v1",
    "removeType": {
      "summary": "Remove one classification while preserving a multi-role Location, or tombstone a Location whose final type is removed.",
      "arguments": ["id", "type", "expectedRevision", "expectedLastEditId", "editedBy"],
      "result": ["action", "locationId", "location", "tombstone"]
    }
  },
  "paths": {
    "/status": { "get": { "responses": { "200": { "description": "Plugin status" } } } },
    "/locations": { "get": { "responses": { "200": { "description": "Locations filtered by workspace" } } } },
    "/deleted": { "get": { "responses": { "200": { "description": "Deletion tombstones available for history and restore" } } } },
    "/locations/{id}": {
      "get": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "description": "Location" } } },
      "put": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "description": "Saved" } } },
      "delete": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "description": "Deleted" } } }
    },
    "/locations/{id}/history": { "get": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "description": "Immutable revision history" } } } },
    "/locations/{id}/restore": { "post": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "description": "Older snapshot restored as a new revision" } } } },
    "/nearest": { "get": { "responses": { "200": { "description": "Nearest matching locations" } } } },
    "/tidal-regions/definitions": { "get": { "responses": { "200": { "description": "Joined tidal ports and region assignments owned by Tidal Database" } } } },
    "/tidal-regions/{id}": {
      "put": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "description": "Serving-port and parent-region assignment saved in Tidal Database" } } },
      "delete": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "responses": { "200": { "description": "Tidal-region assignment removed from Tidal Database" } } }
    },
    "/anchoring/status": { "get": { "responses": { "200": { "description": "Stationary-at-location evidence and current anchoring suggestion/action state" } } } },
    "/anchoring/confirm": { "post": { "responses": { "200": { "description": "Confirm the current suggestion and select Anchored" } } } },
    "/anchoring/dismiss": { "post": { "responses": { "200": { "description": "Dismiss the current suggestion until the vessel leaves or moves" } } } },
    "/local/export": { "get": { "responses": { "200": { "description": "Complete location catalogue" } } } },
    "/local/import": { "post": { "responses": { "200": { "description": "Location catalogue used to replace the current catalogue" } } } },
    "/local/merge": { "post": { "responses": { "200": { "description": "Location catalogue merged per location by latest edit time" } } } },
    "/local/purge-deleted": { "post": { "responses": { "200": { "description": "Confirmed permanent removal of all tombstones and their revision histories" } } } }
  },
  "components": {
    "parameters": {
      "Id": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
    }
  }
}
